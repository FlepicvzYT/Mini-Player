<Window x:Class="MiniPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniPlayer"
        mc:Ignorable="d"
        Title="MiniPlayer"
        Height="376" Width="240"
        MinHeight="300" MinWidth="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Topmost="True"
        Opacity="0">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#121212" />
        <SolidColorBrush x:Key="WindowBorderBrush" Color="Transparent" />
        <Thickness x:Key="WindowBorderThickness">0</Thickness>
        <CornerRadius x:Key="WindowCorner">16</CornerRadius>
        <CornerRadius x:Key="ButtonCorner">100</CornerRadius>
        <CornerRadius x:Key="MenuCorner">10</CornerRadius>
        <CornerRadius x:Key="ItemCorner">6</CornerRadius>
        <SolidColorBrush x:Key="GlossBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TitleBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ArtistBrush" Color="#888888" />
        <SolidColorBrush x:Key="IconBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PlayIconBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CloseBrush" Color="#888888" />
        <SolidColorBrush x:Key="PillBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="PlayBackBrush" Color="#99000000" />
        <SolidColorBrush x:Key="PlayBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="HoverBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CoverBackBrush" Color="#2A2A2A" />
        <SolidColorBrush x:Key="DimBrush" Color="#66000000" />
        <SolidColorBrush x:Key="MenuBackBrush" Color="#1E1E1E" />
        <SolidColorBrush x:Key="MenuTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MenuBorderBrush" Color="#333333" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource IconBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ButtonCorner}" />
                            <Border x:Name="Hover"
                                    Background="{DynamicResource HoverBrush}"
                                    CornerRadius="{DynamicResource ButtonCorner}"
                                    Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.12" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.12" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.18" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.88" Duration="0:0:0.08" />
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.88" Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.12" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.12" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MenuTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ItemHover"
                                    Background="{DynamicResource MenuTextBrush}"
                                    CornerRadius="{DynamicResource ItemCorner}"
                                    Opacity="0" />
                            <ContentPresenter Margin="14,8,22,8"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ItemHover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.14" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ItemHover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="Root"
                Background="{DynamicResource WindowBrush}"
                BorderBrush="{DynamicResource WindowBorderBrush}"
                BorderThickness="{DynamicResource WindowBorderThickness}"
                CornerRadius="{DynamicResource WindowCorner}"
                MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid x:Name="ContentGrid">
                <Border Background="{DynamicResource GlossBrush}"
                        CornerRadius="{DynamicResource WindowCorner}"
                        IsHitTestVisible="False" />

                <Grid x:Name="PlayerLayer">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Viewbox Grid.Row="0"
                             Margin="22,34,22,12"
                             Stretch="Uniform">
                        <Border x:Name="CoverArea"
                                Width="200"
                                Height="200"
                                CornerRadius="16"
                                Background="{DynamicResource CoverBackBrush}"
                                MouseEnter="Cover_MouseEnter"
                                MouseLeave="Cover_MouseLeave">
                            <Border.Clip>
                                <RectangleGeometry x:Name="CoverClip"
                                                   Rect="0,0,200,200"
                                                   RadiusX="16"
                                                   RadiusY="16" />
                            </Border.Clip>
                            <Grid>
                                <Image x:Name="CoverImage"
                                       Stretch="UniformToFill"
                                       Margin="-30"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform x:Name="CoverScale" ScaleX="1" ScaleY="1" />
                                    </Image.RenderTransform>
                                    <Image.Effect>
                                        <BlurEffect x:Name="CoverBlur" Radius="0" />
                                    </Image.Effect>
                                </Image>
                                <Border x:Name="Dim"
                                        Background="{DynamicResource DimBrush}"
                                        Opacity="0"
                                        IsHitTestVisible="False" />
                                <Button x:Name="PlayPauseButton"
                                        Style="{StaticResource IconButton}"
                                        Width="64"
                                        Height="64"
                                        FontSize="26"
                                        Foreground="{DynamicResource PlayIconBrush}"
                                        Background="{DynamicResource PlayBackBrush}"
                                        BorderBrush="{DynamicResource PlayBorderBrush}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RenderTransformOrigin="0.5,0.5"
                                        Click="PlayPause_Click">
                                    <Button.RenderTransform>
                                        <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                                    </Button.RenderTransform>
                                    <Grid>
                                        <TextBlock x:Name="PlayGlyph"
                                                   Text="&#xE768;"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="PlayScale" ScaleX="1" ScaleY="1" />
                                                    <RotateTransform x:Name="PlayRotate" Angle="0" />
                                                </TransformGroup>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock x:Name="PauseGlyph"
                                                   Text="&#xE769;"
                                                   Opacity="0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="PauseScale" ScaleX="0.4" ScaleY="0.4" />
                                                    <RotateTransform x:Name="PauseRotate" Angle="90" />
                                                </TransformGroup>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                    </Viewbox>

                    <StackPanel Grid.Row="1"
                                Margin="14,0,14,12">
                        <TextBlock x:Name="TitleText"
                                   Text="Nothing playing"
                                   Foreground="{DynamicResource TitleBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArtistText"
                                   Text="Open Spotify"
                                   Foreground="{DynamicResource ArtistBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0">
                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE892;"
                                    Width="40"
                                    Height="40"
                                    FontSize="16"
                                    Margin="0,0,12,0"
                                    Click="Previous_Click" />
                            <Button Style="{StaticResource IconButton}"
                                    Content="&#xE893;"
                                    Width="40"
                                    Height="40"
                                    FontSize="16"
                                    Margin="12,0,0,0"
                                    Click="Next_Click" />
                        </StackPanel>
                        <Button x:Name="LyricsButton"
                                Style="{StaticResource IconButton}"
                                Content="&#x266A;"
                                FontFamily="Segoe UI Symbol"
                                FontSize="14"
                                Width="28"
                                Height="28"
                                HorizontalAlignment="Center"
                                Margin="0,2,0,0"
                                Click="Lyrics_Click" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="LyricsLayer"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="LyricsViewport"
                          Grid.Row="0"
                          Margin="14,44,14,6"
                          ClipToBounds="True"
                          Background="Transparent"
                          MouseWheel="LyricsViewport_MouseWheel">
                        <Grid.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0" />
                                <GradientStop Color="Black" Offset="0.14" />
                                <GradientStop Color="Black" Offset="0.86" />
                                <GradientStop Color="Transparent" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.OpacityMask>
                        <StackPanel x:Name="LinesPanel"
                                    VerticalAlignment="Top"
                                    Opacity="0">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="LinesShift" Y="0" />
                            </StackPanel.RenderTransform>
                        </StackPanel>
                        <TextBlock x:Name="LyricsStatus"
                                   Text="Loading lyrics..."
                                   Foreground="{DynamicResource ArtistBrush}"
                                   FontSize="13"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Button x:Name="LyricsBackButton"
                            Grid.Row="1"
                            Style="{StaticResource IconButton}"
                            Content="&#x266A;"
                            FontFamily="Segoe UI Symbol"
                            FontSize="14"
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,14"
                            Click="Lyrics_Click" />
                </Grid>

                <Button x:Name="ThemeButton"
                        Style="{StaticResource IconButton}"
                        Background="{DynamicResource PillBrush}"
                        Height="24"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12,9,0,0"
                        Click="ThemeButton_Click">
                    <Button.Resources>
                        <CornerRadius x:Key="ButtonCorner">6</CornerRadius>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal"
                                Margin="10,0,8,0">
                        <TextBlock x:Name="ThemeNameText"
                                   Text="Sleek"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="8"
                                   Margin="6,1,0,0"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="ChevronRotate" Angle="0" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Popup x:Name="ThemePopup"
                       PlacementTarget="{Binding ElementName=ThemeButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Opened="ThemePopup_Opened"
                       Closed="ThemePopup_Closed">
                    <Border Margin="10"
                            Padding="6"
                            CornerRadius="{DynamicResource MenuCorner}"
                            BorderThickness="1"
                            Background="{DynamicResource MenuBackBrush}"
                            BorderBrush="{DynamicResource MenuBorderBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16"
                                              ShadowDepth="2"
                                              Opacity="0.4" />
                        </Border.Effect>
                        <StackPanel x:Name="ThemeMenu"
                                    MinWidth="130">
                            <Button Style="{StaticResource MenuItemButton}"
                                    Content="Windows 7"
                                    Tag="windows7"
                                    Click="ThemeItem_Click" />
                            <Button Style="{StaticResource MenuItemButton}"
                                    Content="Windows 10"
                                    Tag="windows10"
                                    Click="ThemeItem_Click" />
                            <Button Style="{StaticResource MenuItemButton}"
                                    Content="Sleek"
                                    Tag="sleek"
                                    Click="ThemeItem_Click" />
                            <Button Style="{StaticResource MenuItemButton}"
                                    Content="Rosé Pine"
                                    Tag="rosepine"
                                    Click="ThemeItem_Click" />
                            <Button Style="{StaticResource MenuItemButton}"
                                    Content="Rosé Pine Dawn"
                                    Tag="rosepinedawn"
                                    Click="ThemeItem_Click" />
                            <Button Style="{StaticResource MenuItemButton}"
                                    Content="Frosty"
                                    Tag="frosty"
                                    Click="ThemeItem_Click" />
                            <Button Style="{StaticResource MenuItemButton}"
                                    Content="Liquid Glass"
                                    Tag="liquidglass"
                                    Click="ThemeItem_Click" />
                            <Button Style="{StaticResource MenuItemButton}"
                                    Content="Transparent"
                                    Tag="transparent"
                                    Click="ThemeItem_Click" />
                        </StackPanel>
                    </Border>
                </Popup>

                <TextBlock Text="✕"
                           Foreground="{DynamicResource CloseBrush}"
                           FontSize="14"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top"
                           Margin="0,10,14,0"
                           Cursor="Hand"
                           MouseLeftButtonDown="Close_Click" />
            </Grid>
        </Border>

        <Image x:Name="SnapshotImage"
               Stretch="Fill"
               Visibility="Collapsed"
               IsHitTestVisible="False" />
    </Grid>
</Window>